* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;

    width: 100%;
    height: 100%;

    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    background: #111;
    color: #fff;
}

body {
    overflow: hidden;
}

#app {
    width: 100%;
    height: 100%;

    display: flex;
    flex-direction: column;
}

header {
    padding: 1rem 2rem;

    display: flex;
    justify-content: space-between;
    align-items: center;
}

header h1 {
    margin: 0;
}

#connection-status {
    font-size: 0.9rem;
    opacity: 0.7;
}

#start-screen,
#countdown-screen {
    flex: 1;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 2rem;
}

#live-view {
    width: 90vw;
    max-width: 1000px;

    width: min(90vw, 1000px);
    aspect-ratio: 16 / 9;
    background: #222;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;
}

.camera-container {
    width: min(90vw, 960px);
    aspect-ratio: 16 / 9;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;
    border-radius: 1rem;
}

#camera-stream {
    width: 100%;
    height: 100%;

    object-fit: cover;
    display: block;
}
.camera-placeholder {
    color: #777;
    font-size: 1.5rem;
}

#start-button {
    width: min(80vw, 500px);

    padding: 1.5rem;

    border: none;
    border-radius: 1rem;

    font-size: 2rem;
    font-weight: bold;

    cursor: pointer;
}

#start-button:disabled {
    opacity: 0.4;
    cursor: default;
}
#capture-screen,
#processing-screen,
#error-screen {
    flex: 1;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;
}

.session-message h2 {
    font-size: clamp(2.5rem, 6vw, 5rem);
    margin-bottom: 1rem;
}

.session-message p {
    font-size: clamp(1.5rem, 4vw, 3rem);
}

#restart-button {
    margin-top: 2rem;
    width: auto;
    height: auto;

    padding: 1rem 2rem;

    border-radius: 1rem;

    font-size: 1.5rem;
}

#countdown {
    width: 60vw;
    height: 60vw;

    max-width: 500px;
    max-height: 500px;

    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: min(30vw, 15rem);
    font-weight: bold;

    background: #222;
}

.hidden {
    display: none !important;
}

#preview-screen {
    flex: 1;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 1.5rem;

    padding: 1rem 2rem 2rem;
}


.preview-container {
    width: min(90vw, 1000px);

    aspect-ratio: 3 / 2;

    overflow: hidden;

    background: #fff;

    border-radius: 1rem;
}


#collage-preview {
    width: 100%;
    height: 100%;

    object-fit: contain;

    display: block;
}


.preview-actions {
    display: flex;

    gap: 1.5rem;

    justify-content: center;

    width: 100%;
}


.preview-actions button {
    width: auto;
    height: auto;

    min-width: 220px;

    padding: 1.2rem 2rem;

    border-radius: 1rem;

    font-size: 1.6rem;
}


#print-button:disabled {
    opacity: 0.4;
}

.capture-photo-container {
    width: min(
        80vw,
        720px
    );

    margin: 1rem auto;
}

.capture-photo-container img {
    display: block;

    width: 100%;

    max-height: 55vh;

    object-fit: contain;

    border-radius: 1rem;
}

.next-photo-countdown {
    margin-top: 1rem;

    font-size: clamp(
        5rem,
        18vw,
        10rem
    );

    font-weight: 700;

    line-height: 1;
}

/*
 * Legacy Safari / iOS 9 fallback.
 *
 * Keep the camera view small enough that the
 * Start button remains visible on the iPad 2.
 */

#start-screen {
    justify-content: flex-start;
    padding-top: 1rem;
}

#live-view,
.camera-container {
    width: 90vw;
    max-width: 960px;

    height: 55vh;
    max-height: 500px;

    margin-bottom: 1.5rem;
}

#start-button {
    width: 80vw;
    max-width: 500px;

    flex-shrink: 0;

    margin-bottom: 1rem;
}
